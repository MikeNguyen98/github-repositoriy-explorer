# ── Server-side token for anonymous visitors (strongly recommended) ──────────
# Without it, visitors who aren't signed in share GitHub's 60 requests/hour per IP.
# Create a fine-grained token with NO extra permissions (public data only):
# https://github.com/settings/personal-access-tokens/new
# Server-only. Never prefix with VITE_ — it must not be bundled into the client.
GITHUB_TOKEN=

# ── Sign in with GitHub via Device Flow (optional) ──────────────────────────
# OAuth App: https://github.com/settings/developers → tick "Enable Device Flow".
# Only the client ID is needed — no client secret, no callback URL.
VITE_GITHUB_CLIENT_ID=
# Scopes requested at sign-in. `repo` is required to list your private repositories.
VITE_GITHUB_OAUTH_SCOPE=read:user repo

# Override the API base for anonymous requests (default: the /api/github proxy)
# VITE_API_URL=https://api.github.com
